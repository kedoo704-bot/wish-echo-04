# Public Supabase values for browser auth and public reads.
# Safe to expose; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret. Never prefix this with NEXT_PUBLIC.
# Used only by server routes to create cards, increment views, and upload photos.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site origin used for canonical URLs and share previews.
NEXT_PUBLIC_SITE_URL=https://kehdoo.com
