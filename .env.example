# Public Supabase values for browser auth and public reads.
# Safe to expose; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret. Never prefix this with NEXT_PUBLIC.
# Used only by server routes to create cards, increment views, and upload photos.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site origin used for canonical URLs and share previews.
NEXT_PUBLIC_SITE_URL=https://kehdoo.com

# PostHog product analytics. Optional — analytics stay off (no init call
# fires) if NEXT_PUBLIC_POSTHOG_KEY is unset, so this is safe to omit locally.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Tag Manager — marketing-managed pixels (separate from PostHog
# product events). Optional — no GTM request fires at all if unset. Use
# Kehdoo's own container ID here, not another product's.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
